# Server Port
PORT=5000

# Security & JWT
JWT_SECRET=your_super_secure_jwt_secret_key_here

# Telegram Bot Token (for HMAC-SHA256 validation)
TELEGRAM_BOT_TOKEN=1234567890:ABCdefGhIJKlmNoPQRsTUVwxyZ

# PostgreSQL Connection String (Optional, fallback to persistent JSON storage)
DATABASE_URL=postgresql://postgres:password@localhost:5432/bude_delivery?schema=public

# Development Mode Settings
ALLOW_DEV_LOGIN=true
CORS_ORIGIN=*
