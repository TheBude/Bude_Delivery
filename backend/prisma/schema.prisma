// Bude Delivery - Prisma Schema for PostgreSQL
// Fully typed models with indexes and referential integrity

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPPLIER
  RECEIVER
}

enum OrderStatus {
  PENDING
  PREPARING
  IN_TRANSIT
  DELIVERED
  REJECTED
}

model User {
  id              String    @id @default(uuid())
  telegram_id     BigInt?   @unique
  email           String?   @unique
  password_hash   String?
  google_id       String?   @unique
  avatar_url      String?
  role            Role
  first_name      String
  last_name       String
  phone_primary   String
  phone_secondary String?
  language        String    @default("uz")
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  supplier        Supplier?
  ordersReceived  Order[]   @relation("ReceiverOrders")

  @@index([telegram_id])
  @@index([email])
  @@index([role])
  @@map("users")
}

model Supplier {
  id               String    @id @default(uuid())
  user_id          String    @unique
  user             User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  company_name     String
  delivery_fee     Decimal   @default(0.0) @db.Decimal(12, 2)
  is_free_delivery Boolean   @default(false)
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  products         Product[]
  orders           Order[]   @relation("SupplierOrders")

  @@index([user_id])
  @@index([company_name])
  @@map("suppliers")
}

model Product {
  id                String      @id @default(uuid())
  supplier_id       String
  supplier          Supplier    @relation(fields: [supplier_id], references: [id], onDelete: Cascade)
  name              String
  description       String?
  price             Decimal     @db.Decimal(12, 2)
  discount_price    Decimal?    @db.Decimal(12, 2)
  is_available      Boolean     @default(true)
  quantity_optional Int?
  image_url         String?
  created_at        DateTime    @default(now())
  updated_at        DateTime    @updatedAt

  orderItems        OrderItem[]

  @@index([supplier_id])
  @@index([is_available])
  @@map("products")
}

model Order {
  id                 String       @id @default(uuid())
  receiver_id        String
  receiver           User         @relation("ReceiverOrders", fields: [receiver_id], references: [id])
  supplier_id        String
  supplier           Supplier     @relation("SupplierOrders", fields: [supplier_id], references: [id])
  status             OrderStatus  @default(PENDING)
  delivery_lat       Float
  delivery_lng       Float
  delivery_address   String
  delivery_time_slot String
  notes              String?
  total_price        Decimal      @db.Decimal(12, 2)
  rejection_reason   String?
  created_at         DateTime     @default(now())
  updated_at         DateTime     @updatedAt

  items              OrderItem[]
  delivery           Delivery?

  @@index([receiver_id])
  @@index([supplier_id])
  @@index([status])
  @@index([created_at])
  @@map("orders")
}

model OrderItem {
  id             String   @id @default(uuid())
  order_id       String
  order          Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  product_id     String
  product        Product  @relation(fields: [product_id], references: [id])
  quantity       Int      @default(1)
  price_at_order Decimal  @db.Decimal(12, 2)

  @@index([order_id])
  @@index([product_id])
  @@map("order_items")
}

model Delivery {
  id                   String   @id @default(uuid())
  order_id             String   @unique
  order                Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  vehicle_model        String
  vehicle_plate_number String
  driver_name          String
  driver_phone         String
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  @@index([order_id])
  @@index([driver_phone])
  @@map("deliveries")
}
